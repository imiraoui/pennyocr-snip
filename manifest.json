{
  "manifest_version": 3,
  "name": "PennyOCR Snip: Screenshot to Text (OCR)",
  "version": "0.4.0",
  "description": "Screenshot to text in one click. OCR any image, chart, scan or locked PDF into clean text or Markdown. 3 free snips, no account.",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "https://api.pennyocr.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PennyOCR Snip \u2014 Alt+Shift+P to snip"
  },
  "commands": {
    "snip-region": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "Snip a region and OCR it (Mac: Option+Shift+P)"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}